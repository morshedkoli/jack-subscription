generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Domain {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  domain    String   @unique
  expiresAt DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("domains")
}
